# ─────────────────────────────────────────────────────────────
# Hostinger (Apache / LiteSpeed) — static React site
# Upload the CONTENTS of dist/ into public_html/ (this file included).
# ─────────────────────────────────────────────────────────────

Options -MultiViews -Indexes
RewriteEngine On

# Force HTTPS (enable SSL in hPanel first)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SPA routing: serve real files/folders directly, everything else → index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# never rewrite missing content/audio/assets to index.html (return a real 404 instead)
RewriteRule ^(content|assets|brand|images)/ - [L,R=404]
RewriteRule ^ index.html [L]

# Correct MIME types for audio & data
<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType audio/mp4 .m4a
  AddType audio/aac .aac
  AddType audio/ogg .ogg .oga
  AddType audio/opus .opus
  AddType audio/wav .wav
  AddType application/json .json
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>

# Compression (text only — audio/images are already compressed)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching
<IfModule mod_headers.c>
  # hashed build assets never change
  <FilesMatch "^assets/.*\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # covers, logos, audio: long cache (rename files when replacing them)
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|mp3|m4a|aac|ogg|opus|wav)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # content JSON & HTML: always revalidate so edits appear immediately
  <FilesMatch "\.(json|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
